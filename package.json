{
  "name": "graphql-job-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A portfolio project for learning GraphQL by building a job application tracker.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "start": "node dist/src/index.js",
    "prebuild": "prisma generate",
    "build": "tsc",
    "build:client": "npm --prefix client run build",
    "lint:client": "npm --prefix client run lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "pretest": "prisma migrate deploy --config prisma.test.config.ts",
    "test": "npm run build && node --test dist/test/config.test.js dist/test/server.test.js"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphile/depth-limit": "^0.3.1",
    "@graphql-tools/schema": "^10.1.1",
    "@graphql-tools/utils": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "graphql": "^16.0.0",
    "graphql-query-complexity": "^2.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "@apollo/protobufjs@1.2.8": true
  }
}
